+class AlfworldGroupWorker:
+    """Ray actor holding several single-env ALFWorld instances, stepped one after another.
+
+    One Ray process per env costs 50-85 threads; with 128 train + 274 eval envs that exceeds the container's
+    7680-thread limit, so envs are packed several per actor. Env j uses base_envs[j] (its game list) and seeds[j].
+    """
+
+    def __init__(self, base_envs, seeds):
+        self.envs = []
+        for base_env, seed in zip(base_envs, seeds):
+            env = base_env.init_env(batch_size=1)
+            env.seed(seed)
+            self.envs.append(env)
+
+    def step(self, actions):
+        results = []
+        for env, action in zip(self.envs, actions):
+            obs, scores, dones, infos = env.step([action])
+            infos['observation_text'] = obs
+            results.append((obs, scores, dones, infos))
+        return results
+
+    def reset(self):
+        results = []
+        for env in self.envs:
+            obs, infos = env.reset()
+            infos['observation_text'] = obs
+            results.append((obs, infos))
+        return results
+
