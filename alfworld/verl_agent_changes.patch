+class AlfworldGroupWorker:
+    """Ray actor holding several single-env ALFWorld instances, stepped one after another.
+
+    One Ray process per env costs 50-85 threads; with 128 train + 274 eval envs that exceeds the container's
+    7680-thread limit, so envs are packed several per actor. Env j uses base_envs[j] (its game list) and seeds[j].
+    """
+
+    def __init__(self, base_envs, seeds, track_achievements=False):
+        # track_achievements (hindsight training): request TextWorld state facts and record per episode the achieved
+        # ALFWorld goals and the executed (action, feedback) steps; the facts never leave the actor.
+        self.track_achievements = track_achievements
+        if track_achievements:
+            import textworld
+            original_env_infos = textworld.EnvInfos
+
+            def env_infos_with_facts(*args, **kwargs):
+                kwargs["facts"] = True
+                return original_env_infos(*args, **kwargs)
+
+            textworld.EnvInfos = env_infos_with_facts
+        self.envs = []
+        for base_env, seed in zip(base_envs, seeds):
+            env = base_env.init_env(batch_size=1)
+            env.seed(seed)
+            self.envs.append(env)
+        if track_achievements:
+            textworld.EnvInfos = original_env_infos
+        self.trackers = [None] * len(self.envs)
+
+    def step(self, actions):
+        results = []
+        for index, (env, action) in enumerate(zip(self.envs, actions)):
+            obs, scores, dones, infos = env.step([action])
+            if self.track_achievements:
+                tracker = self.trackers[index]
+                tracker.update(infos.pop('facts')[0], action, obs[0])
+                tracker.done = tracker.done or bool(dones[0])
+            infos['observation_text'] = obs
+            results.append((obs, scores, dones, infos))
+        return results
+
+    def reset(self):
+        results = []
+        for index, env in enumerate(self.envs):
+            obs, infos = env.reset()
+            if self.track_achievements:
+                self.trackers[index] = AchievementTracker(infos.pop('facts')[0])
+            infos['observation_text'] = obs
+            results.append((obs, infos))
+        return results
+
+    def records(self):
+        return [tracker.record() for tracker in self.trackers]
+
