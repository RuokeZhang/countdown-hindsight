+def near_equal_sizes(num_rows, num_parts):
+    """Sizes of num_parts consecutive parts of num_rows rows that differ by at most one."""
+    num_parts = min(num_rows, num_parts)
+    return [num_rows // num_parts + (index < num_rows % num_parts) for index in range(num_parts)]
