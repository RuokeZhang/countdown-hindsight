+def compute_group_outcome_metrics(batch: DataProto) -> dict:
+    """Share of GRPO groups (same uid) whose episodes all failed, mixed, or all succeeded; success = episode reward > 0."""
+    episode_won = {}
+    for uid, traj_uid, episode_reward in zip(batch.non_tensor_batch["uid"], batch.non_tensor_batch["traj_uid"], batch.non_tensor_batch["episode_rewards"]):
+        episode_won[traj_uid] = (uid, float(episode_reward) > 0)
+    wins_by_group = defaultdict(list)
+    for uid, won in episode_won.values():
+        wins_by_group[uid].append(won)
+    groups = list(wins_by_group.values())
+    return {
+        "groups/count": len(groups),
+        "groups/episodes": len(episode_won),
+        "groups/episode_success_rate": float(np.mean([won for _, won in episode_won.values()])),
+        "groups/all_fail_rate": float(np.mean([not any(wins) for wins in groups])),
+        "groups/mixed_rate": float(np.mean([any(wins) and not all(wins) for wins in groups])),
+        "groups/all_success_rate": float(np.mean([all(wins) for wins in groups])),
+    }
+
+
+def append_metrics_jsonl(metrics: dict, step: int) -> None:
+    """Also write each logged step to $METRICS_JSONL (one JSON object per line), if set."""
+    path = os.environ.get("METRICS_JSONL")
+    if path:
+        with open(path, "a") as metrics_file:
+            metrics_file.write(json.dumps({"step": step, "data": {key: float(value) for key, value in metrics.items() if np.isscalar(value)}}) + "\n")
+
