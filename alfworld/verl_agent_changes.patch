+def hindsight_loss_term(hindsight_pg_loss, micro_batch_tokens, mini_batch_tokens, coef, cap):
+    """LfH term lambda * min(L_H, c) for one micro-batch. L_H is the token mean over the hindsight action tokens of the
+    whole mini-batch, so a micro-batch contributes its own token mean times its share of those tokens: every hindsight
+    token gets the same weight however the rows fall into micro-batches. The cap is checked on the micro-batch's L_H."""
+    if cap is not None and hindsight_pg_loss.item() > cap:
+        return hindsight_pg_loss * 0.0
+    return coef * hindsight_pg_loss * (micro_batch_tokens / mini_batch_tokens)
+
