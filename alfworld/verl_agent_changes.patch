+    if action_only_mask:
+        # compute_response_mask returns a view of attention_mask; writing into it in place would also drop the
+        # hindsight rows' thought tokens from the model input
+        response_mask = batch.batch["response_mask"].clone()
+        response_mask[is_hindsight] = response_mask[is_hindsight] * batch.batch["action_mask"][is_hindsight].to(response_mask.dtype)
+        batch.batch["response_mask"] = response_mask
