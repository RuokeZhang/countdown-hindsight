+def apply_hindsight_masks(batch: DataProto, action_only_mask: bool, shuffle_seed: int) -> None:
+    """Flags hindsight rows for the actor's separate LfH loss term, masks their non-action tokens, and shuffles the rows:
+    hindsight rows are appended after the original ones and _balance_batch keeps index order within each rank, so
+    without the shuffle the last mini-batches would hold only hindsight rows."""
